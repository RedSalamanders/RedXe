{
  "version": 2,
  "defaultBranch": "main",
  "buildNumber": "mergeBaseCount",
  "nativeInventory": {
    "path": "Tests/native-test-files.json",
    "exclude": [
      "Specs/**",
      "Measurements/**"
    ],
    "testFolders": [
      "Tests/**",
      "**/SelfTest/**"
    ]
  },
  "runtimeFiles": [
    "Settings/RedXe-debug.settings.json",
    "Settings/RedXe.settings.json",
    "Settings/SettingsStore.schema.json",
    "DxUi.provenance.json"
  ],
  "prose": [
    ".agents/**/*.md",
    ".github/skills/**/*.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "Changes/**/*.md",
    "Changes/README.md",
    "CLAUDE.md",
    "docs/**/*.md",
    "docs/plugins/README.md",
    "docs/README.md",
    "docs/screenshots/README.md",
    "Measurements/AVIntegration/2026-09-05/av-touch-2026-09-05/README.md",
    "Measurements/AVIntegration/2026-09-05/embedded-text-v1-2026-09-05/README.md",
    "Measurements/AVIntegration/2026-09-05/primary-high-contrast-2026-09-05/README.md",
    "Measurements/AVIntegration/2026-09-05/README.md",
    "Measurements/DxUiAdoption/2026-09-09/README.md",
    "Measurements/DxUiAdoption/2026-09-12/README.md",
    "Measurements/DxUiAdoption/2026-09-13/arm64-builds/README.md",
    "Measurements/DxUiAdoption/2026-09-13/README.md",
    "Measurements/RedMonitor_Adoption_2026-10-23/README.md",
    "Measurements/TestingAcceleration_2026-11-10_SDK2/README.md",
    "Measurements/TestingAcceleration_2026-11-10_SdkAvMeasurement/README.md",
    "Measurements/TestingAcceleration_2026-11-10/README.md",
    "Measurements/Toolchain/2026-10-23-msvc1452/README.md",
    "Plugins/5H4D3R5/README.md",
    "Plugins/Actions/Zoom/AGENTS.md",
    "Plugins/Actions/Zoom/CLAUDE.md",
    "Plugins/Actions/Zoom/README.md",
    "Plugins/AVControl/AGENTS.md",
    "Plugins/AVControl/Camera/README.md",
    "Plugins/AVControl/CLAUDE.md",
    "Plugins/AVControl/README.md",
    "Plugins/DeskClock/AGENTS.md",
    "Plugins/DeskClock/CLAUDE.md",
    "Plugins/DeskClock/README.md",
    "Plugins/Launcher/AGENTS.md",
    "Plugins/Launcher/CLAUDE.md",
    "Plugins/Launcher/README.md",
    "Plugins/Logicon/AGENTS.md",
    "Plugins/Logicon/CLAUDE.md",
    "Plugins/Logicon/README.md",
    "Plugins/MatrixRain/README.md",
    "Plugins/StudioClock/AGENTS.md",
    "Plugins/StudioClock/CLAUDE.md",
    "Plugins/StudioClock/README.md",
    "Plugins/SystemData/AGENTS.md",
    "Plugins/SystemData/CLAUDE.md",
    "Plugins/SystemData/README.md",
    "Plugins/Weather/AGENTS.md",
    "Plugins/Weather/CLAUDE.md",
    "Plugins/Weather/README.md",
    "README.md",
    "Specs/**/*.md",
    "Specs/Plans/Done/README.md",
    "Specs/Plans/WIP/README.md",
    "Specs/README.md",
    "Tools/README.md"
  ],
  "unscoped": [
    "docs/**",
    "Measurements/**",
    "Mockups/**"
  ],
  "scopes": [
    {
      "name": "LauncherAlias",
      "native": true,
      "reuse": true
    },
    {
      "name": "Packaging",
      "native": true,
      "reuse": true
    },
    {
      "name": "PluginContract",
      "native": true,
      "reuse": true
    },
    {
      "name": "AVControl",
      "native": true,
      "reuse": true
    },
    {
      "name": "SystemData",
      "native": true,
      "reuse": true
    },
    {
      "name": "SystemDataPhase0",
      "native": true,
      "reuse": true
    },
    {
      "name": "StudioClock",
      "native": true,
      "reuse": true
    },
    {
      "name": "DeskClock",
      "native": true,
      "reuse": true
    },
    {
      "name": "Launcher",
      "native": true,
      "reuse": true
    },
    {
      "name": "Weather",
      "native": true,
      "reuse": true
    },
    {
      "name": "Logicon",
      "native": true,
      "reuse": true
    },
    {
      "name": "Zoom",
      "native": true,
      "reuse": true
    },
    {
      "name": "Settings",
      "native": true,
      "reuse": true
    },
    {
      "name": "HostPlugin",
      "native": true,
      "reuse": true
    },
    {
      "name": "HostSmoke",
      "native": true,
      "reuse": true
    },
    {
      "name": "BuildProcess",
      "native": false,
      "reuse": true,
      "commands": [
        {
          "path": "Tests/BuildProcessTests/Invoke-ToolingTests.ps1",
          "arguments": []
        }
      ]
    },
    {
      "name": "Format",
      "native": false,
      "reuse": true,
      "commands": [
        {
          "path": "format.ps1",
          "arguments": [
            "-Check"
          ]
        }
      ]
    }
  ],
  "rules": [
    {
      "pattern": "Tools/**",
      "scopes": [
        "BuildProcess"
      ],
      "reason": "repository Changes workflow and behavioral fixtures"
    },
    {
      "pattern": "Plugins/AVControl/**",
      "scopes": [
        "AVControl",
        "PluginContract",
        "HostPlugin",
        "HostSmoke",
        "Packaging",
        "Settings"
      ],
      "reason": "plugin contracts, shared host-settings consumers, host integration and deployment"
    },
    {
      "pattern": "Plugins/SystemData/**",
      "scopes": [
        "SystemData",
        "PluginContract",
        "HostPlugin",
        "HostSmoke",
        "Packaging",
        "SystemDataPhase0"
      ],
      "reason": "plugin contracts, host integration and deployment"
    },
    {
      "pattern": "Plugins/StudioClock/**",
      "scopes": [
        "StudioClock",
        "PluginContract",
        "HostPlugin",
        "HostSmoke",
        "Packaging",
        "Settings"
      ],
      "reason": "plugin contracts, shared host-settings consumers, host integration and deployment"
    },
    {
      "pattern": "Plugins/DeskClock/**",
      "scopes": [
        "DeskClock",
        "PluginContract",
        "HostPlugin",
        "HostSmoke",
        "Packaging"
      ],
      "reason": "plugin contracts, host integration and deployment"
    },
    {
      "pattern": "Plugins/Launcher/**",
      "scopes": [
        "Launcher",
        "PluginContract",
        "HostPlugin",
        "HostSmoke",
        "Packaging",
        "Settings"
      ],
      "reason": "plugin contracts, shared host-settings consumers, host integration and deployment"
    },
    {
      "pattern": "Plugins/Weather/**",
      "scopes": [
        "Weather",
        "PluginContract",
        "HostPlugin",
        "HostSmoke",
        "Packaging"
      ],
      "reason": "plugin contracts, host integration and deployment"
    },
    {
      "pattern": "Plugins/Logicon/**",
      "scopes": [
        "Logicon",
        "PluginContract",
        "HostPlugin",
        "HostSmoke",
        "Packaging",
        "Settings"
      ],
      "reason": "plugin contracts, shared host-settings consumers, host integration and deployment"
    },
    {
      "pattern": "Plugins/Actions/Zoom/**",
      "scopes": [
        "Zoom",
        "PluginContract",
        "HostPlugin",
        "HostSmoke",
        "Packaging",
        "Settings"
      ],
      "reason": "plugin contracts, shared host-settings consumers, host integration and deployment"
    },
    {
      "pattern": "Tests/PluginContractTests/**",
      "scopes": [
        "PluginContract"
      ],
      "reason": "owning native test project"
    },
    {
      "pattern": "Tests/AVControlTests/**",
      "scopes": [
        "AVControl"
      ],
      "reason": "owning native test project"
    },
    {
      "pattern": "Tests/SystemDataTests/**",
      "scopes": [
        "SystemData"
      ],
      "reason": "owning native test project"
    },
    {
      "pattern": "Tests/StudioClockTests/**",
      "scopes": [
        "StudioClock"
      ],
      "reason": "owning native test project"
    },
    {
      "pattern": "Tests/DeskClockTests/**",
      "scopes": [
        "DeskClock"
      ],
      "reason": "owning native test project"
    },
    {
      "pattern": "Tests/LauncherTests/**",
      "scopes": [
        "Launcher"
      ],
      "reason": "owning native test project"
    },
    {
      "pattern": "Tests/WeatherTests/**",
      "scopes": [
        "Weather"
      ],
      "reason": "owning native test project"
    },
    {
      "pattern": "Tests/LogiconTests/**",
      "scopes": [
        "Logicon"
      ],
      "reason": "owning native test project"
    },
    {
      "pattern": "Tests/ZoomTests/**",
      "scopes": [
        "Zoom"
      ],
      "reason": "owning native test project"
    },
    {
      "pattern": "Tests/SettingsTests/**",
      "scopes": [
        "Settings"
      ],
      "reason": "owning native test project"
    },
    {
      "pattern": "Tests/HostPluginTests/**",
      "scopes": [
        "HostPlugin",
        "HostSmoke"
      ],
      "reason": "the shared HostPluginTests executable supplies plugin and smoke tests"
    },
    {
      "pattern": "Tests/SystemDataPhase0/**",
      "scopes": [
        "SystemDataPhase0"
      ],
      "reason": "system data acquisition fixture"
    },
    {
      "pattern": "Tests/*/*.vcxproj",
      "scopes": [
        "PluginContract",
        "HostPlugin",
        "HostSmoke",
        "Packaging"
      ],
      "reason": "every project builds into the shared output folder: deployed files and referenced product builds reach the host, smoke and package consumers"
    },
    {
      "pattern": "RedXe/Settings*",
      "scopes": [
        "Settings",
        "HostPlugin",
        "HostSmoke"
      ],
      "reason": "settings parser and live application behavior"
    },
    {
      "pattern": "Settings/**",
      "scopes": [
        "Settings",
        "HostPlugin",
        "HostSmoke"
      ],
      "reason": "shipped settings and schema integration"
    },
    {
      "pattern": "Specs/SettingsStore.schema.json",
      "scopes": [
        "Settings",
        "HostPlugin",
        "HostSmoke"
      ],
      "reason": "executable settings schema"
    },
    {
      "pattern": "RedXeLauncher/**",
      "scopes": [
        "LauncherAlias",
        "Packaging"
      ],
      "reason": "portable command alias"
    },
    {
      "pattern": "Tests/BuildProcessTests/**",
      "scopes": [
        "BuildProcess",
        "Packaging"
      ],
      "reason": "build/process/packaging tooling"
    },
    {
      "pattern": ".agents/**",
      "scopes": [
        "BuildProcess"
      ],
      "reason": "skill metadata read only by the skill validator"
    },
    {
      "pattern": "validate-skills.ps1",
      "scopes": [
        "BuildProcess"
      ],
      "reason": "skill validation tooling",
      "exclusive": true
    },
    {
      "pattern": "Tools/Test-AgentGuidance.ps1",
      "scopes": [
        "BuildProcess"
      ],
      "reason": "independent agent guidance validation",
      "exclusive": true
    },
    {
      "pattern": "**/*.cpp",
      "scopes": [
        "Format"
      ],
      "reason": "native source formatting",
      "additive": true
    },
    {
      "pattern": "**/*.h",
      "scopes": [
        "Format"
      ],
      "reason": "native header formatting",
      "additive": true
    }
  ],
  "watchedProcesses": [
    "RedXe.exe",
    "DxUi.ControlTests.exe",
    "DxUi.EmbeddedTests.exe",
    "DxUi.FoundationTests.exe",
    "DxUi.InteractiveLease.exe"
  ],
  "prePushProfiles": [
    {
      "platform": "x64",
      "configuration": "Debug",
      "buildOnly": false
    },
    {
      "platform": "x64",
      "configuration": "Release",
      "buildOnly": false
    },
    {
      "platform": "x64",
      "configuration": "ASan Debug",
      "buildOnly": false
    },
    {
      "platform": "ARM64",
      "configuration": "Debug",
      "buildOnly": true
    },
    {
      "platform": "ARM64",
      "configuration": "Release",
      "buildOnly": true
    },
    {
      "platform": "ARM64",
      "configuration": "ASan Debug",
      "buildOnly": true
    }
  ],
  "instrumentationVariables": [
    "ASAN_OPTIONS"
  ],
  "systemFiles": [
    "d2d1.dll",
    "d3d10warp.dll",
    "d3d11.dll",
    "dwrite.dll",
    "dxgi.dll",
    "windowscodecs.dll"
  ]
}
