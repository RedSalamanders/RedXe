# Common block: the same lines in every RedSalamanders repository (RedHome convergence D-03, D-04).
# Text is stored with LF. Sources, scripts and Visual Studio files check out with CRLF, as .clang-format
# (LineEnding: CRLF) and Visual Studio write them; Markdown, JSON and YAML check out with LF.
# Repository lines follow the block and take precedence; nested .gitattributes protect vendored bytes.
* text=auto
*.c text eol=crlf
*.cc text eol=crlf
*.cpp text eol=crlf
*.cxx text eol=crlf
*.h text eol=crlf
*.hh text eol=crlf
*.hpp text eol=crlf
*.hxx text eol=crlf
*.hlsl text eol=crlf
*.hlsli text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.png binary
*.ico binary
*.bmp binary
*.jpg binary
*.gif binary
*.zip binary
# End of the common block.
