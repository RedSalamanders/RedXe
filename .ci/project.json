{
  "schemaVersion": 1,
  "policyVersion": "1",
  "repository": "RedSalamanders/RedXe",
  "engine": {
    "repository": "RedSalamanders/.github",
    "ref": "5233b5271f268cbe7aa420c18250347c297da63a"
  },
  "kind": "application",
  "adapter": "Tools/Invoke-ProjectCi.ps1",
  "include": [
    "Tests/Fixtures/**"
  ],
  "exclude": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    "Specs/**/*.md",
    "Plugins/**/README.md",
    "Tests/README.md",
    ".github/skills/**/*.md",
    "Specs/Plans/**",
    "Specs/TestRuns/**",
    "Specs/Mockups/**",
    "Measurements/**",
    "docs/**",
    "Changes/**",
    "legacy/**",
    ".agents/**",
    ".claude/**",
    ".vscode/**",
    ".github/ISSUE_TEMPLATE/**",
    ".github/dependabot.yml",
    ".github/CODEOWNERS"
  ],
  "formatRoots": [
    "Common",
    "Plugins",
    "RedXe",
    "RedXeLauncher",
    "Tests"
  ],
  "formatExclude": [],
  "versionBase": "1.0",
  "winget": {
    "identifier": "RedSalamanders.RedXe",
    "executable": "RedXeLauncher.exe",
    "alias": "redxe",
    "license": "MIT",
    "minimumOSVersion": "10.0.19041.0",
    "smokeTests": [
      {
        "timeoutSeconds": 300,
        "command": "redxe",
        "arguments": [
          "--self-test",
          "--warp"
        ]
      }
    ]
  }
}