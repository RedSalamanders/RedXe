{
  "$schema": "RedXe.settings.schema.json",
  "schemaVersion": 3,
  "plugins": [
    {
      "id": "builtin.rotating-triangle",
      "enabled": false,
      "private": {}
    },
    {
      "id": "builtin.gdi-orbit",
      "enabled": false,
      "private": {}
    },
    {
      "id": "builtin.matrix-rain",
      "enabled": true,
      "private": {}
    }
  ],
  "dashboard": {
    "grid": {
      "columns": 32,
      "rows": 9
    },
    "activePageId": "page.matrix",
    "pages": [
      {
        "id": "page.matrix",
        "name": "Matrix",
        "widgets": [
          {
            "id": "matrix-rain.1",
            "pluginId": "builtin.matrix-rain",
            "typeId": "matrix-rain",
            "placement": { "column": 0, "row": 0, "columnSpan": 32, "rowSpan": 9 },
            "private": {
              "seed": 1999,
              "glyphHeightDips": 18,
              "densityPercent": 70,
              "speedPercent": 100,
              "trailLengthGlyphs": 18,
              "mutationPerSecond": 8,
              "headColor": "#D8FFE5",
              "trailColor": "#00E65C",
              "backgroundColor": "#010502",
              "glowPercent": 35
            }
          }
        ]
      },
      {
        "id": "page.matrix-alt",
        "name": "Matrix Alternate",
        "widgets": [
          {
            "id": "matrix-rain.alt",
            "pluginId": "builtin.matrix-rain",
            "typeId": "matrix-rain",
            "placement": { "column": 0, "row": 0, "columnSpan": 32, "rowSpan": 9 },
            "private": {
              "seed": 2000,
              "glyphHeightDips": 20,
              "densityPercent": 80,
              "speedPercent": 110,
              "trailLengthGlyphs": 20,
              "mutationPerSecond": 9,
              "headColor": "#E6FFF0",
              "trailColor": "#00D957",
              "backgroundColor": "#010502",
              "glowPercent": 40
            }
          }
        ]
      }
    ]
  }
}
