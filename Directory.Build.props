<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <RequiredMsvcToolsVersion>14.52</RequiredMsvcToolsVersion>
    <!-- ARM64 SystemData exceeds the 32-bit compiler-host heap under MSVC 14.52. -->
    <PreferredToolArchitecture Condition="'$(Platform)'=='ARM64' and '$(PreferredToolArchitecture)'=='' and ('$(PROCESSOR_ARCHITECTURE)'=='ARM64' or '$(PROCESSOR_ARCHITEW6432)'=='ARM64')">arm64</PreferredToolArchitecture>
    <PreferredToolArchitecture Condition="'$(Platform)'=='ARM64' and '$(PreferredToolArchitecture)'==''">x64</PreferredToolArchitecture>
    <SolutionDir Condition="'$(SolutionDir)'==''">$(MSBuildThisFileDirectory)</SolutionDir>
    <PreferredToolArchitecture Condition="'$(PreferredToolArchitecture)'=='' and ('$(PROCESSOR_ARCHITECTURE)'=='ARM64' or '$(PROCESSOR_ARCHITEW6432)'=='ARM64')">arm64</PreferredToolArchitecture>
    <PreferredToolArchitecture Condition="'$(PreferredToolArchitecture)'=='' and ('$(PROCESSOR_ARCHITECTURE)'=='AMD64' or '$(PROCESSOR_ARCHITEW6432)'=='AMD64')">x64</PreferredToolArchitecture>
    <RedXeBuildRoot>$(MSBuildThisFileDirectory).build\</RedXeBuildRoot>
    <OutDir>$(RedXeBuildRoot)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(RedXeBuildRoot)Intermediate\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
    <TargetName>$(MSBuildProjectName)</TargetName>

    <!-- Keep each platform's vcpkg metadata private, matching RedSalamander's manifest layout. -->
    <RedXeVcpkgPlatformScope Condition="'$(Platform)'=='ARM64'">arm64</RedXeVcpkgPlatformScope>
    <RedXeVcpkgPlatformScope Condition="'$(RedXeVcpkgPlatformScope)'==''">x64</RedXeVcpkgPlatformScope>
    <RedXeVcpkgTriplet Condition="'$(Platform)'=='ARM64'">arm64-windows</RedXeVcpkgTriplet>
    <RedXeVcpkgTriplet Condition="'$(RedXeVcpkgTriplet)'==''">x64-windows</RedXeVcpkgTriplet>
    <VcpkgManifestRoot>$(MSBuildThisFileDirectory)</VcpkgManifestRoot>
    <VcpkgInstalledDir>$(RedXeBuildRoot)vcpkg_installed\$(RedXeVcpkgPlatformScope)\</VcpkgInstalledDir>
    <VcpkgEnabled>false</VcpkgEnabled>

    <!-- Third version component stamped into every version resource. build.ps1 sets it to -BuildNumber
         or, by default, the commit count of HEAD (the release workflow stamps the same). Only ResourceCompile sees
         it so a new number never recompiles C++ translation units. See Common/Version.h. -->
    <RedXeBuildNumber Condition="'$(RedXeBuildNumber)'==''">0</RedXeBuildNumber>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='ASan Debug'">
    <EnableASAN>true</EnableASAN>
    <LinkIncremental>false</LinkIncremental>
    <!-- One producer for each shared runtime directory, after the full build completes. -->
    <CopyAsanBinariesToOutDir Condition="'$(MSBuildProjectName)'=='RedXe' or '$(MSBuildProjectName)'=='AVControl'">true</CopyAsanBinariesToOutDir>
    <CopyAsanBinariesToOutDir Condition="'$(MSBuildProjectName)'!='RedXe' and '$(MSBuildProjectName)'!='AVControl'">false</CopyAsanBinariesToOutDir>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj'">
    <ClCompile>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <WarningLevel>EnableAllWarnings</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 /permissive- /Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(MSBuildThisFileDirectory)Common;$(VcpkgInstalledDir)$(RedXeVcpkgTriplet)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <ResourceCompile>
      <PreprocessorDefinitions>REDXE_VERSION_BUILD=$(RedXeBuildNumber);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and ('$(Configuration)'=='Debug' or '$(Configuration)'=='ASan Debug')">
    <Link>
      <AdditionalLibraryDirectories>$(VcpkgInstalledDir)$(RedXeVcpkgTriplet)\debug\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and '$(Configuration)'=='Release'">
    <Link>
      <AdditionalLibraryDirectories>$(VcpkgInstalledDir)$(RedXeVcpkgTriplet)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

<Import Project="$(MSBuildThisFileDirectory)Build\RedMonitor.props" />
  <ItemDefinitionGroup><ClCompile><AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories></ClCompile></ItemDefinitionGroup>
</Project>
