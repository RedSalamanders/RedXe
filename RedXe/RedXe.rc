#include "resource.h"
#include "../Common/Version.h"
#include <windows.h>

#pragma code_page(65001)

IDI_REDXE ICON "assets\\redxe-xenon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION REDXE_VERSION_NUMERIC
 PRODUCTVERSION REDXE_VERSION_NUMERIC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", REDXE_VERSION_COMPANY "\0"
            VALUE "FileDescription", "RedXe XENEON dashboard\0"
            VALUE "FileVersion", REDXE_VERSION_STRING "\0"
            VALUE "InternalName", "RedXe\0"
            VALUE "LegalCopyright", REDXE_VERSION_COPYRIGHT "\0"
            VALUE "OriginalFilename", "RedXe.exe\0"
            VALUE "ProductName", REDXE_VERSION_PRODUCT "\0"
            VALUE "ProductVersion", REDXE_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_TRAY_MENU MENU
BEGIN
    POPUP "RedXe"
    BEGIN
        MENUITEM "&Edit settings", IDM_TRAY_EDIT_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_TRAY_EXIT
    END
END

STRINGTABLE
BEGIN
    IDS_PRODUCT_TITLE "RedXe"
    IDS_WINDOW_TITLE "RedXe — CORSAIR XENEON"
    IDS_WINDOW_SETTINGS "RedXe settings"
    IDS_WINDOW_SETTINGS_ERROR "RedXe settings error"
    IDS_WINDOW_ACTION_NOTICE "RedXe action notice"
    IDS_COMMAND_LINE_TITLE "RedXe command line"
    IDS_BUTTON_OK "OK"
    IDS_TRAY_TOOLTIP_DEBUG "RedXe (Debug)"
    IDS_XENEON_MISSING_TITLE "RedXe — XENEON display missing"
    IDS_XENEON_MISSING_PROMPT "A CORSAIR XENEON display was not found.\n\nDo you want to display RedXe anyway in a standard window with a title bar?"
    IDS_PREVIOUS_CRASH_TITLE "RedXe — previous crash detected"
    IDS_PREVIOUS_CRASH_PROMPT "RedXe ended unexpectedly during its previous run. Open the crash folder?"
    IDS_PREVIOUS_CRASH_WITH_PATH "RedXe ended unexpectedly during its previous run. A diagnostic minidump and call-stack report were saved beside each other at:\n\n{0}\n\nOpen the crash folder?"
    IDS_EXIT_STARTUP_FAILED "RedXe could not start. See the debugger output."
    IDS_EXIT_SETTINGS_FAILED "RedXe could not load settings. See the debugger output."
    IDS_EXIT_WINDOW_FAILED "RedXe could not create its window. See the debugger output."
    IDS_EXIT_PLUGINS_FAILED "RedXe could not initialize bundled plugins. See the debugger output."
    IDS_EXIT_RENDERER_FAILED "RedXe could not complete graphics initialization or rendering. See the debugger output."
    IDS_EXIT_WATCHER_FAILED "RedXe could not watch its settings file. See the debugger output."
END
