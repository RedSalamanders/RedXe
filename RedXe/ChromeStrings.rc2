#include "resource.h"
#include <windows.h>


LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_PRODUCT_TITLE "RedXe"
    IDS_WINDOW_TITLE "RedXe — CORSAIR XENEON"
    IDS_WINDOW_SETTINGS "RedXe settings"
    IDS_WINDOW_SETTINGS_ERROR "RedXe settings error"
    IDS_WINDOW_ACTION_NOTICE "RedXe action notice"
    IDS_COMMAND_LINE_TITLE "RedXe command line"
    IDS_BUTTON_OK "OK"
    IDS_TRAY_TOOLTIP_DEBUG "RedXe (Debug)"
    IDS_XENEON_MISSING_TITLE "RedXe — XENEON display missing"
    IDS_XENEON_MISSING_PROMPT "A CORSAIR XENEON display was not found.\n\nDo you want to display RedXe anyway in a standard window with a title bar?"
    IDS_PREVIOUS_CRASH_TITLE "RedXe — previous crash detected"
    IDS_PREVIOUS_CRASH_PROMPT "RedXe ended unexpectedly during its previous run. Open the crash folder?"
    IDS_PREVIOUS_CRASH_WITH_PATH "RedXe ended unexpectedly during its previous run. A diagnostic minidump and call-stack report were saved beside each other at:\n\n{0}\n\nOpen the crash folder?"
    IDS_EXIT_STARTUP_FAILED "RedXe could not start. See the debugger output."
    IDS_EXIT_SETTINGS_FAILED "RedXe could not load settings. See the debugger output."
    IDS_EXIT_WINDOW_FAILED "RedXe could not create its window. See the debugger output."
    IDS_EXIT_PLUGINS_FAILED "RedXe could not initialize bundled plugins. See the debugger output."
    IDS_EXIT_RENDERER_FAILED "RedXe could not complete graphics initialization or rendering. See the debugger output."
    IDS_EXIT_WATCHER_FAILED "RedXe could not watch its settings file. See the debugger output."
    IDS_SETTINGS_READ_FAILED "The settings file could not be read. The current dashboard remains active."
    IDS_SETTINGS_MISSING "The settings file is missing. The current dashboard remains active."
    IDS_SETTINGS_INVALID "The settings file could not be applied. The current dashboard remains active."
    IDS_SETTINGS_APPLY_FAILED "The changed settings could not be applied. The previous dashboard was restored."
    IDS_SETTINGS_SELECTED_FALLBACK "The selected settings file could not be loaded. RedXe is running with its default configuration; the selected file was not changed."
    IDS_SETTINGS_RECOVERY_PRESERVED "RedXe could not parse the default settings file. The backup is at {0}."
    IDS_SETTINGS_RECOVERY_INSTALLED "RedXe could not parse the default settings file. The backup is at {0}.\n\nA fresh default configuration was installed."
    IDS_SETTINGS_DIAGNOSTIC_LOCATION "Line {0}, column {1}"
    IDS_SETTINGS_DIAGNOSTIC_PATH "Path: {0}"
    IDS_SETTINGS_DIAGNOSTIC_VERSION "The settings file is not valid version 5."
    IDS_SETTINGS_MANAGED_FALLBACK "RedXe is running with its default configuration. Your settings file is still at {0}."
    IDS_USAGE_PROBE "Use --probe or --probe=<seconds>, once, with 1 through 3600 whole seconds."
    IDS_USAGE_SETTINGS "Use --settings followed by exactly one settings file path."
    IDS_USAGE_CAPTURE "Use --capture <file.png> [--page <id>] [--widget <ordinal>] [--after <milliseconds>]."
    IDS_USAGE_CAPTURE_DELAY "--after takes a delay of 1 through 120000 milliseconds."
    IDS_USAGE_CAPTURE_WIDGET "--widget takes the 0-based ordinal of a widget on the captured page."
    IDS_USAGE_CRASH_PROBE "Use --crash-probe <directory> once without the legacy crash switches."
    IDS_USAGE_DOCK "--dock takes none, top, bottom, left, or right, optionally followed by @primary, @secondary, @xeneon, @<n>, or @name:<substring>."
    IDS_USAGE_DOCK_MODE "--dock-mode takes fixed or autohide."
    IDS_USAGE_DOCK_THICKNESS "--dock-thickness takes 32 through 1080 DIPs."
    IDS_USAGE_DOCK_RESERVE "--dock-reserve takes on or off."
    IDS_USAGE_DOCK_PEEK "--dock-peek takes 1 through 64 pixels."
    IDS_ACTION_NAMESPACE_MISSING "Action namespace ""{0}"" is not provided by {1}; its bindings are disabled."
    IDS_ACTION_INVALID_CONTRACT "Actions ""{0}.*"" are unavailable: {1} published an invalid contract."
    IDS_ACTION_BUILTIN_COLLISION "Action namespace ""{0}"" is published by both RedXe and {1}; only RedXe is used."
    IDS_ACTION_NAMESPACE_UNKNOWN "Action namespace ""{0}"" from {1} is not registered and is ignored."
    IDS_ACTION_PUBLISHER_COLLISION "Action namespace ""{0}"" is published by both {1} and another module; only the registered publisher is used."
    IDS_ACTION_MODULE_LOAD_FAILED "Actions ""{0}.*"" are unavailable: {1} could not be loaded."
    IDS_ACTION_EXECUTOR_FAILED "Actions ""{0}.*"" are unavailable: {1} could not create its executor."
END
