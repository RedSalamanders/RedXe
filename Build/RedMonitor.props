<Project>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)'=='RedXe' or '$(MSBuildProjectName)'=='HostPluginTests'">
    <ClCompile><AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\ThirdParty\RedMonitor\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories></ClCompile>
  </ItemDefinitionGroup>
  <!-- Windows PowerShell, so an IDE build needs no PowerShell 7. Reruns only when the verifier, lock or client
       files are newer than the per-project stamp; a missing input always reruns and fails. -->
  <Target Name="RequirePinnedRedMonitorClient" BeforeTargets="PrepareForBuild" Condition="'$(MSBuildProjectName)'=='RedXe' or '$(MSBuildProjectName)'=='HostPluginTests'"
          Inputs="$(MSBuildThisFileDirectory)..\Verify-RedMonitorClient.ps1;$(MSBuildThisFileDirectory)..\Dependencies\RedMonitor.lock.json;$(MSBuildThisFileDirectory)..\ThirdParty\RedMonitor\include\RedMonitor\Client.h;$(MSBuildThisFileDirectory)..\ThirdParty\RedMonitor\LICENSE.txt"
          Outputs="$(IntDir)RedMonitorClient.verified">
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\Verify-RedMonitorClient.ps1&quot;" />
    <MakeDir Directories="$(IntDir)" />
    <Touch Files="$(IntDir)RedMonitorClient.verified" AlwaysCreate="true" />
  </Target>
</Project>
