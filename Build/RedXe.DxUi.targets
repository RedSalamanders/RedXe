<Project>
  <Import Project="$(DxUiRoot)\Build\DxUi.Consumer.targets" />
  <ItemGroup Condition="'$(DxUiRoot)'!=''">
    <ProjectReference Update="$(DxUiResolvedRoot)src\DxUi.vcxproj">
      <AdditionalProperties>%(ProjectReference.AdditionalProperties);WholeProgramOptimization=$(WholeProgramOptimization);VCToolsVersion=$(VCToolsVersion)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup Condition="'$(DxUiRoot)'!='' and '$(Platform)'=='ARM64'">
    <ProjectReference Update="$(DxUiResolvedRoot)src\DxUi.vcxproj">
      <AdditionalProperties>%(ProjectReference.AdditionalProperties);PreferredToolArchitecture=$(PreferredToolArchitecture)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup></Project>
