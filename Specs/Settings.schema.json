{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RedXe.settings.schema.json",
  "title": "RedXe settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pages"],
  "properties": {
    "$schema": { "const": "RedXe.settings.schema.json" },
    "version": { "$ref": "#/$defs/version" },
    "wrapPages": { "type": "boolean", "default": false },
    "declare": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "minLength": 1, "maxLength": 128 },
      "additionalProperties": { "$ref": "#/$defs/widgetDefinition" }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major"],
      "properties": {
        "major": { "const": 4 },
        "minor": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "matrixSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295, "default": 1999 },
        "glyphHeightDips": { "type": "integer", "minimum": 12, "maximum": 48, "default": 18 },
        "densityPercent": { "type": "integer", "minimum": 10, "maximum": 100, "default": 70 },
        "speedPercent": { "type": "integer", "minimum": 25, "maximum": 300, "default": 100 },
        "trailLengthGlyphs": { "type": "integer", "minimum": 6, "maximum": 48, "default": 18 },
        "mutationPerSecond": { "type": "integer", "minimum": 0, "maximum": 30, "default": 8 },
        "headColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#D8FFE5" },
        "trailColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#00E65C" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#010502" },
        "glowPercent": { "type": "integer", "minimum": 0, "maximum": 100, "default": 35 }
      }
    },
    "widgetDefinition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "enum": ["builtin.rotating-triangle", "builtin.gdi-orbit"] },
            "settings": { "type": "object", "maxProperties": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.matrix-rain" },
            "settings": { "$ref": "#/$defs/matrixSettings" }
          }
        }
      ]
    },
    "widgetUse": {
      "oneOf": [
        { "$ref": "#/$defs/widgetDefinition" },
        { "type": "string", "minLength": 1, "maxLength": 128 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["use", "override"],
          "properties": {
            "use": { "type": "string", "minLength": 1, "maxLength": 128 },
            "override": { "type": "object" }
          }
        }
      ]
    },
    "leafArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeRatio", "widget"],
      "properties": {
        "sizeRatio": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "widget": { "$ref": "#/$defs/widgetUse" }
      }
    },
    "containerArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeRatio", "arrangeAlong", "areas"],
      "properties": {
        "sizeRatio": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "arrangeAlong": { "enum": ["long-side", "short-side"] },
        "areas": { "type": "array", "minItems": 1, "maxItems": 127, "items": { "$ref": "#/$defs/area" } }
      }
    },
    "area": { "oneOf": [{ "$ref": "#/$defs/leafArea" }, { "$ref": "#/$defs/containerArea" }] },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arrangeAlong", "areas"],
      "properties": {
        "arrangeAlong": { "enum": ["long-side", "short-side"] },
        "areas": { "type": "array", "minItems": 1, "maxItems": 127, "items": { "$ref": "#/$defs/area" } }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "layout": { "$ref": "#/$defs/layout" }
      }
    }
  }
}
