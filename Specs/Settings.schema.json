{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RedXe.settings.schema.json",
  "title": "RedXe settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pages"],
  "properties": {
    "$schema": { "const": "RedXe.settings.schema.json" },
    "version": { "$ref": "#/$defs/version" },
    "wrapPages": { "type": "boolean", "default": false },
    "logRetentionDays": { "type": "integer", "minimum": 1, "maximum": 365, "default": 15 },
    "backgroundColor": {
      "$ref": "#/$defs/color",
      "default": "#000000",
      "description": "Dashboard background: the host canvas and the background every widget paints unless a widget object overrides it."
    },
    "declare": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "minLength": 1, "maxLength": 128 },
      "additionalProperties": { "$ref": "#/$defs/widgetDefinition" }
    },
    "services": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": { "minLength": 1, "maxLength": 128 },
      "additionalProperties": { "$ref": "#/$defs/serviceDefinition" },
      "description": "Headless service plugins the host starts at launch (settings minor 1). Each catalogued service plugin may appear once."
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major"],
      "properties": {
        "major": { "const": 5 },
        "minor": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "widgetBackground": {
      "$ref": "#/$defs/color",
      "description": "Host-reserved widget key: this instance paints this background instead of the document backgroundColor."
    },
    "matrixSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295, "default": 1999 },
        "glyphHeightDips": { "type": "integer", "minimum": 12, "maximum": 48, "default": 18 },
        "densityPercent": { "type": "integer", "minimum": 10, "maximum": 100, "default": 70 },
        "speedPercent": { "type": "integer", "minimum": 25, "maximum": 300, "default": 100 },
        "trailLengthGlyphs": { "type": "integer", "minimum": 6, "maximum": 48, "default": 18 },
        "mutationPerSecond": { "type": "integer", "minimum": 0, "maximum": 30, "default": 8 },
        "headColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#D8FFE5" },
        "trailColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#00E65C" },
        "glowPercent": { "type": "integer", "minimum": 0, "maximum": 100, "default": 35 }
      }
    },
    "rankedViewerSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topN": { "type": "integer", "minimum": 1, "maximum": 16, "default": 8 }
      }
    },
    "processViewerSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topN": { "type": "integer", "minimum": 1, "maximum": 32, "default": 10 }
      }
    },
    "studioClockSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showSecondProgress": { "type": "boolean", "default": true },
        "externalDotsAlwaysOn": { "type": "boolean", "default": true },
        "showSeconds": { "type": "boolean", "default": true },
        "secondsColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FF1616" },
        "showDate": { "type": "boolean", "default": false },
        "dateFormat": {
          "enum": ["dd-mm-yyyy", "mm-dd-yyyy", "yyyy-mm-dd"],
          "default": "dd-mm-yyyy"
        },
        "timeColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FF1616" }
      }
    },
    "weatherSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locationMode": { "type": "string", "enum": ["automatic", "manual"] },
        "location": { "type": "string" },
        "temperatureUnit": { "type": "string", "enum": ["celsius", "fahrenheit"] },
        "windUnit": { "type": "string", "enum": ["kmh", "mph"] }
      }
    },
    "avControlSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "outputId",
              "microphoneId",
              "cameraId",
              "audioRoles",
              "restoreLevels",
              "outputLevel",
              "microphoneLevel"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              },
              "outputId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "microphoneId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "cameraId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "audioRoles": {
                "type": "string",
                "enum": [
                  "all",
                  "communications"
                ]
              },
              "restoreLevels": {
                "type": "boolean"
              },
              "outputLevel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "microphoneLevel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "launcherSettings": {
      "type": "object",
      "description": "An empty shortcuts list imports taskbar pins once and saves them as editable per-widget shortcuts.",
      "additionalProperties": false,
      "properties": {
        "iconSize": {
          "type": "string",
          "enum": ["small", "medium", "large", "huge", "automatic"],
          "default": "huge",
          "description": "Fixed cells: small 72 DIP, medium 96 DIP, large 144 DIP, huge 192 DIP (default). automatic starts at huge and shrinks toward small before paging."
        },
        "shortcuts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "description": "Closed list of 0 through 32 shortcuts.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target"],
            "properties": {
              "target": { "type": "string", "minLength": 1, "maxLength": 512 },
              "iconPng": { "type": "string", "maxLength": 260 }
            }
          }
        }
      }
    },
    "deskClockSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flipDurationMilliseconds": { "type": "integer", "minimum": 250, "maximum": 800, "default": 420 },
        "cardColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FF3B43" },
        "digitColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FFFFFF" },
        "dateColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#D8D8D8" }
      }
    },
    "weight": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 1 },
    "logiconKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot"],
      "properties": {
        "page": { "type": "integer", "minimum": 0, "maximum": 3, "default": 0 },
        "slot": { "type": "integer", "minimum": 0, "maximum": 8 },
        "action": {
          "enum": ["none", "page.next", "page.previous", "page.goto", "widget.raise", "widget.dismiss", "widget.toggle", "launch", "keys", "keyPage.next", "keyPage.previous"],
          "default": "none"
        },
        "target": { "type": "string", "maxLength": 512 },
        "label": { "type": "string", "maxLength": 16 },
        "icon": { "type": "string", "maxLength": 260 },
        "color": { "$ref": "#/$defs/color" },
        "face": { "enum": ["none", "clock", "pageIndicator", "cpu", "memory", "gpu"], "default": "none" }
      }
    },
    "logiconDialAction": { "enum": ["none", "volume", "page", "keyPage", "brightness"], "default": "none" },
    "logiconDialButton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["button"],
      "properties": {
        "button": { "type": "integer", "minimum": 0, "maximum": 3 },
        "action": { "$ref": "#/$defs/logiconKey/properties/action" },
        "target": { "type": "string", "maxLength": 512 }
      }
    },
    "logiconDialpad": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dial": { "$ref": "#/$defs/logiconDialAction" },
        "roller": { "$ref": "#/$defs/logiconDialAction" },
        "buttons": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/logiconDialButton" } }
      }
    },
    "logiconSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brightness": { "type": "integer", "minimum": 1, "maximum": 100, "default": 70 },
        "restoreLogoOnExit": { "type": "boolean", "default": true },
        "pageButtons": { "enum": ["keyPages", "dashboardPages"], "default": "keyPages" },
        "keys": { "type": "array", "maxItems": 36, "items": { "$ref": "#/$defs/logiconKey" } },
        "dialpad": { "$ref": "#/$defs/logiconDialpad" }
      }
    },
    "serviceDefinition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.logicon" },
            "brightness": { "$ref": "#/$defs/logiconSettings/properties/brightness" },
            "restoreLogoOnExit": { "$ref": "#/$defs/logiconSettings/properties/restoreLogoOnExit" },
            "pageButtons": { "$ref": "#/$defs/logiconSettings/properties/pageButtons" },
            "keys": { "$ref": "#/$defs/logiconSettings/properties/keys" },
            "dialpad": { "$ref": "#/$defs/logiconSettings/properties/dialpad" }
          }
        }
      ]
    },
    "pluginId": {
      "enum": [
        "builtin.rotating-triangle",
        "builtin.gdi-orbit",
        "builtin.matrix-rain",
        "builtin.studio-clock",
        "builtin.desk-clock",
        "builtin.weather",
        "builtin.launcher",
        "builtin.av-control",
        "builtin.process-viewer",
        "builtin.system-pulse",
        "builtin.cpu-meter",
        "builtin.memory-meter",
        "builtin.network-meter",
        "builtin.storage-meter",
        "builtin.gpu-meter",
        "builtin.gpu-processes",
        "builtin.power-meter",
        "builtin.thermal-meter",
        "builtin.logicon-monitor"
      ]
    },
    "widgetDefinition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "enum": ["builtin.rotating-triangle", "builtin.gdi-orbit", "builtin.system-pulse", "builtin.cpu-meter", "builtin.memory-meter", "builtin.storage-meter", "builtin.gpu-meter", "builtin.power-meter", "builtin.thermal-meter", "builtin.logicon-monitor"] },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.matrix-rain" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "seed": { "$ref": "#/$defs/matrixSettings/properties/seed" },
            "glyphHeightDips": { "$ref": "#/$defs/matrixSettings/properties/glyphHeightDips" },
            "densityPercent": { "$ref": "#/$defs/matrixSettings/properties/densityPercent" },
            "speedPercent": { "$ref": "#/$defs/matrixSettings/properties/speedPercent" },
            "trailLengthGlyphs": { "$ref": "#/$defs/matrixSettings/properties/trailLengthGlyphs" },
            "mutationPerSecond": { "$ref": "#/$defs/matrixSettings/properties/mutationPerSecond" },
            "headColor": { "$ref": "#/$defs/matrixSettings/properties/headColor" },
            "trailColor": { "$ref": "#/$defs/matrixSettings/properties/trailColor" },
            "glowPercent": { "$ref": "#/$defs/matrixSettings/properties/glowPercent" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.process-viewer" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "topN": { "$ref": "#/$defs/processViewerSettings/properties/topN" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "enum": ["builtin.network-meter", "builtin.gpu-processes"] },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "topN": { "$ref": "#/$defs/rankedViewerSettings/properties/topN" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.studio-clock" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "showSecondProgress": { "$ref": "#/$defs/studioClockSettings/properties/showSecondProgress" },
            "externalDotsAlwaysOn": { "$ref": "#/$defs/studioClockSettings/properties/externalDotsAlwaysOn" },
            "showSeconds": { "$ref": "#/$defs/studioClockSettings/properties/showSeconds" },
            "secondsColor": { "$ref": "#/$defs/studioClockSettings/properties/secondsColor" },
            "showDate": { "$ref": "#/$defs/studioClockSettings/properties/showDate" },
            "dateFormat": { "$ref": "#/$defs/studioClockSettings/properties/dateFormat" },
            "timeColor": { "$ref": "#/$defs/studioClockSettings/properties/timeColor" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.desk-clock" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "flipDurationMilliseconds": { "$ref": "#/$defs/deskClockSettings/properties/flipDurationMilliseconds" },
            "cardColor": { "$ref": "#/$defs/deskClockSettings/properties/cardColor" },
            "digitColor": { "$ref": "#/$defs/deskClockSettings/properties/digitColor" },
            "dateColor": { "$ref": "#/$defs/deskClockSettings/properties/dateColor" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.weather" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "locationMode": { "$ref": "#/$defs/weatherSettings/properties/locationMode" },
            "location": { "$ref": "#/$defs/weatherSettings/properties/location" },
            "temperatureUnit": { "$ref": "#/$defs/weatherSettings/properties/temperatureUnit" },
            "windUnit": { "$ref": "#/$defs/weatherSettings/properties/windUnit" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.launcher" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "iconSize": { "$ref": "#/$defs/launcherSettings/properties/iconSize" },
            "shortcuts": { "$ref": "#/$defs/launcherSettings/properties/shortcuts" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.av-control" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "profiles": { "$ref": "#/$defs/avControlSettings/properties/profiles" }
          }
        }
      ]
    },
    "widgetUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use"],
      "properties": {
        "use": { "type": "string", "minLength": 1, "maxLength": 128 },
        "plugin": { "$ref": "#/$defs/pluginId" },
        "seed": { "$ref": "#/$defs/matrixSettings/properties/seed" },
        "glyphHeightDips": { "$ref": "#/$defs/matrixSettings/properties/glyphHeightDips" },
        "densityPercent": { "$ref": "#/$defs/matrixSettings/properties/densityPercent" },
        "speedPercent": { "$ref": "#/$defs/matrixSettings/properties/speedPercent" },
        "trailLengthGlyphs": { "$ref": "#/$defs/matrixSettings/properties/trailLengthGlyphs" },
        "mutationPerSecond": { "$ref": "#/$defs/matrixSettings/properties/mutationPerSecond" },
        "headColor": { "$ref": "#/$defs/matrixSettings/properties/headColor" },
        "trailColor": { "$ref": "#/$defs/matrixSettings/properties/trailColor" },
        "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
        "glowPercent": { "$ref": "#/$defs/matrixSettings/properties/glowPercent" },
        "topN": { "type": "integer", "minimum": 1, "maximum": 32 },
        "showSecondProgress": { "type": "boolean" },
        "externalDotsAlwaysOn": { "type": "boolean" },
        "showSeconds": { "type": "boolean" },
        "secondsColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "showDate": { "type": "boolean" },
        "dateFormat": { "enum": ["dd-mm-yyyy", "mm-dd-yyyy", "yyyy-mm-dd"] },
        "timeColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "flipDurationMilliseconds": { "type": "integer", "minimum": 250, "maximum": 800 },
        "cardColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "digitColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "dateColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "locationMode": { "type": "string", "enum": ["automatic", "manual"] },
        "location": { "type": "string" },
        "temperatureUnit": { "type": "string", "enum": ["celsius", "fahrenheit"] },
        "windUnit": { "type": "string", "enum": ["kmh", "mph"] },
        "iconSize": { "$ref": "#/$defs/launcherSettings/properties/iconSize" },
        "shortcuts": { "$ref": "#/$defs/launcherSettings/properties/shortcuts" },
        "profiles": { "$ref": "#/$defs/avControlSettings/properties/profiles" }
      }
    },
    "widgetValue": {
      "oneOf": [
        { "$ref": "#/$defs/widgetDefinition" },
        { "type": "string", "minLength": 1, "maxLength": 128 },
        { "$ref": "#/$defs/widgetUse" }
      ]
    },
    "splitItem": {
      "oneOf": [
        { "$ref": "#/$defs/widgetValue" },
        { "$ref": "#/$defs/weightedWidget" },
        { "$ref": "#/$defs/weightedRows" },
        { "$ref": "#/$defs/weightedColumns" }
      ]
    },
    "weightedWidget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widget"],
      "properties": {
        "weight": { "$ref": "#/$defs/weight" },
        "widget": { "$ref": "#/$defs/widgetValue" }
      }
    },
    "weightedRows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "weight": { "$ref": "#/$defs/weight" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 127,
          "items": { "$ref": "#/$defs/splitItem" }
        }
      }
    },
    "weightedColumns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "weight": { "$ref": "#/$defs/weight" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 127,
          "items": { "$ref": "#/$defs/splitItem" }
        }
      }
    },
    "page": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["widgets"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "along": { "enum": ["long-side", "short-side"], "default": "long-side" },
            "widgets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/widgetValue" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 127,
              "items": { "$ref": "#/$defs/splitItem" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 127,
              "items": { "$ref": "#/$defs/splitItem" }
            }
          }
        }
      ]
    }
  }
}
