{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RedXe.settings.schema.json",
  "title": "RedXe settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pages"],
  "properties": {
    "$schema": { "const": "RedXe.settings.schema.json" },
    "version": { "$ref": "#/$defs/version" },
    "wrapPages": { "type": "boolean", "default": false },
    "logRetentionDays": { "type": "integer", "minimum": 1, "maximum": 365, "default": 15 },
    "declare": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "minLength": 1, "maxLength": 128 },
      "additionalProperties": { "$ref": "#/$defs/widgetDefinition" }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major"],
      "properties": {
        "major": { "const": 4 },
        "minor": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "matrixSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295, "default": 1999 },
        "glyphHeightDips": { "type": "integer", "minimum": 12, "maximum": 48, "default": 18 },
        "densityPercent": { "type": "integer", "minimum": 10, "maximum": 100, "default": 70 },
        "speedPercent": { "type": "integer", "minimum": 25, "maximum": 300, "default": 100 },
        "trailLengthGlyphs": { "type": "integer", "minimum": 6, "maximum": 48, "default": 18 },
        "mutationPerSecond": { "type": "integer", "minimum": 0, "maximum": 30, "default": 8 },
        "headColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#D8FFE5" },
        "trailColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#00E65C" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#010502" },
        "glowPercent": { "type": "integer", "minimum": 0, "maximum": 100, "default": 35 }
      }
    },
    "rankedViewerSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topN": { "type": "integer", "minimum": 1, "maximum": 16, "default": 8 }
      }
    },
    "processViewerSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topN": { "type": "integer", "minimum": 1, "maximum": 32, "default": 10 }
      }
    },
    "studioClockSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showSecondProgress": { "type": "boolean", "default": true },
        "externalDotsAlwaysOn": { "type": "boolean", "default": true },
        "showSeconds": { "type": "boolean", "default": true },
        "secondsColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FF1616" },
        "showDate": { "type": "boolean", "default": false },
        "dateFormat": {
          "enum": ["dd-mm-yyyy", "mm-dd-yyyy", "yyyy-mm-dd"],
          "default": "dd-mm-yyyy"
        },
        "timeColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FF1616" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#111111" }
      }
    },
    "weatherSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locationMode": { "type": "string", "enum": ["automatic", "manual"] },
        "location": { "type": "string" },
        "temperatureUnit": { "type": "string", "enum": ["celsius", "fahrenheit"] },
        "windUnit": { "type": "string", "enum": ["kmh", "mph"] }
      }
    },
    "avControlSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "outputId",
              "microphoneId",
              "cameraId",
              "audioRoles",
              "restoreLevels",
              "outputLevel",
              "microphoneLevel"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              },
              "outputId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "microphoneId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "cameraId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "audioRoles": {
                "type": "string",
                "enum": [
                  "all",
                  "communications"
                ]
              },
              "restoreLevels": {
                "type": "boolean"
              },
              "outputLevel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "microphoneLevel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "launcherSettings": {
      "type": "object",
      "description": "An empty shortcuts list imports taskbar pins once and saves them as editable per-widget shortcuts.",
      "additionalProperties": false,
      "properties": {
        "shortcuts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target"],
            "properties": {
              "target": { "type": "string", "minLength": 1, "maxLength": 512 },
              "iconPng": { "type": "string", "maxLength": 260 }
            }
          }
        }
      }
    },
    "deskClockSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flipDurationMilliseconds": { "type": "integer", "minimum": 250, "maximum": 800, "default": 420 },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#000000" },
        "cardColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FF3B43" },
        "digitColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FFFFFF" },
        "dateColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#D8D8D8" }
      }
    },
    "widgetDefinition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "enum": ["builtin.rotating-triangle", "builtin.gdi-orbit", "builtin.system-pulse", "builtin.cpu-meter", "builtin.memory-meter", "builtin.storage-meter", "builtin.gpu-meter", "builtin.power-meter", "builtin.thermal-meter"] },
            "settings": { "type": "object", "maxProperties": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.matrix-rain" },
            "settings": { "$ref": "#/$defs/matrixSettings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.process-viewer" },
            "settings": { "$ref": "#/$defs/processViewerSettings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "enum": ["builtin.network-meter", "builtin.gpu-processes"] },
            "settings": { "$ref": "#/$defs/rankedViewerSettings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.studio-clock" },
            "settings": { "$ref": "#/$defs/studioClockSettings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.desk-clock" },
            "settings": { "$ref": "#/$defs/deskClockSettings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.weather" },
            "settings": { "$ref": "#/$defs/weatherSettings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.launcher" },
            "settings": { "$ref": "#/$defs/launcherSettings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.av-control" },
            "settings": { "$ref": "#/$defs/avControlSettings" }
          }
        }
      ]
    },
    "widgetUse": {
      "oneOf": [
        { "$ref": "#/$defs/widgetDefinition" },
        { "type": "string", "minLength": 1, "maxLength": 128 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["use", "override"],
          "properties": {
            "use": { "type": "string", "minLength": 1, "maxLength": 128 },
            "override": { "type": "object" }
          }
        }
      ]
    },
    "leafArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeRatio", "widget"],
      "properties": {
        "sizeRatio": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "widget": { "$ref": "#/$defs/widgetUse" }
      }
    },
    "containerArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeRatio", "arrangeAlong", "areas"],
      "properties": {
        "sizeRatio": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "arrangeAlong": { "enum": ["long-side", "short-side"] },
        "areas": { "type": "array", "minItems": 1, "maxItems": 127, "items": { "$ref": "#/$defs/area" } }
      }
    },
    "area": { "oneOf": [{ "$ref": "#/$defs/leafArea" }, { "$ref": "#/$defs/containerArea" }] },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arrangeAlong", "areas"],
      "properties": {
        "arrangeAlong": { "enum": ["long-side", "short-side"] },
        "areas": { "type": "array", "minItems": 1, "maxItems": 127, "items": { "$ref": "#/$defs/area" } }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "layout": { "$ref": "#/$defs/layout" }
      }
    }
  }
}
