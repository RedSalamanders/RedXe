{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RedXe.settings.schema.json",
  "title": "RedXe settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pages"],
  "properties": {
    "$schema": { "const": "RedXe.settings.schema.json" },
    "version": { "$ref": "#/$defs/version" },
    "wrapPages": { "type": "boolean", "default": false },
    "logRetentionDays": { "type": "integer", "minimum": 1, "maximum": 365, "default": 15 },
    "backgroundColor": {
      "$ref": "#/$defs/color",
      "default": "#000000",
      "description": "Dashboard background: the host canvas and the background every widget paints unless a widget object overrides it."
    },
    "declare": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "minLength": 1, "maxLength": 128 },
      "additionalProperties": { "$ref": "#/$defs/widgetDefinition" }
    },
    "dock": {
      "$ref": "#/$defs/dock",
      "description": "Screen-edge dock (settings minor 2): RedXe as a bar on one edge of one monitor. Omitted, or edge none, keeps the standard XENEON window."
    },
    "services": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": { "minLength": 1, "maxLength": 128 },
      "additionalProperties": { "$ref": "#/$defs/serviceDefinition" },
      "description": "Headless service plugins the host starts at launch (settings minor 1). Each catalogued service plugin may appear once."
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major"],
      "properties": {
        "major": { "const": 5 },
        "minor": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "widgetBackground": {
      "$ref": "#/$defs/color",
      "description": "Host-reserved widget key: this instance paints this background instead of the document backgroundColor."
    },
    "matrixSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295, "default": 1999 },
        "glyphHeightDips": { "type": "integer", "minimum": 12, "maximum": 48, "default": 18 },
        "densityPercent": { "type": "integer", "minimum": 10, "maximum": 100, "default": 70 },
        "speedPercent": { "type": "integer", "minimum": 25, "maximum": 300, "default": 100 },
        "trailLengthGlyphs": { "type": "integer", "minimum": 6, "maximum": 48, "default": 18 },
        "mutationPerSecond": { "type": "integer", "minimum": 0, "maximum": 30, "default": 8 },
        "headColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#D8FFE5" },
        "trailColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#00E65C" },
        "glowPercent": { "type": "integer", "minimum": 0, "maximum": 100, "default": 35 }
      }
    },
    "shadersSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["single", "random", "slideshow"],
          "default": "slideshow",
          "description": "single shows `shader`; random picks one at start; slideshow shows every bundled shader in turn, starting at `shader`."
        },
        "shader": {
          "type": "string",
          "enum": ["fluid-solver", "cineshader-lava", "synthwave-sunset", "seascape", "warp-fbm", "fractal-pyramid", "octagrams", "heartfelt", "protean-clouds", "drive-home", "flammes-vortex", "neon-pulse", "cosmic-orb"],
          "default": "seascape",
          "description": "Short name of a bundled shader; docs/plugins/5h4d3r5.md shows each one (twelve Shadertoy ports and the RedXe cosmic orb)."
        },
        "intervalSeconds": { "type": "integer", "minimum": 10, "maximum": 3600, "default": 120 },
        "shuffle": { "type": "boolean", "default": false, "description": "Slideshow order: false cycles the catalog in order, true shuffles each round." },
        "renderScalePercent": {
          "type": "integer",
          "minimum": 25,
          "maximum": 100,
          "default": 50,
          "description": "Shader resolution as a percentage of the tile, upscaled on the GPU; the ray-marched shaders are heavy at full size."
        }
      }
    },
    "rankedViewerSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topN": { "type": "integer", "minimum": 1, "maximum": 16, "default": 8 }
      }
    },
    "processViewerSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topN": { "type": "integer", "minimum": 1, "maximum": 32, "default": 10 }
      }
    },
    "studioClockSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showSecondProgress": { "type": "boolean", "default": true },
        "externalDotsAlwaysOn": { "type": "boolean", "default": true },
        "showSeconds": { "type": "boolean", "default": true },
        "secondsColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FF1616" },
        "showDate": { "type": "boolean", "default": false },
        "dateFormat": {
          "enum": ["dd-mm-yyyy", "mm-dd-yyyy", "yyyy-mm-dd"],
          "default": "dd-mm-yyyy"
        },
        "timeColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FF1616" }
      }
    },
    "weatherSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locationMode": { "type": "string", "enum": ["automatic", "manual"] },
        "location": { "type": "string" },
        "temperatureUnit": { "type": "string", "enum": ["celsius", "fahrenheit"] },
        "windUnit": { "type": "string", "enum": ["kmh", "mph"] }
      }
    },
    "avControlSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "outputId",
              "microphoneId",
              "cameraId",
              "audioRoles",
              "restoreLevels",
              "outputLevel",
              "microphoneLevel"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              },
              "outputId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "microphoneId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "cameraId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "audioRoles": {
                "type": "string",
                "enum": [
                  "all",
                  "communications"
                ]
              },
              "restoreLevels": {
                "type": "boolean"
              },
              "outputLevel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "microphoneLevel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "launcherSettings": {
      "type": "object",
      "description": "An empty shortcuts list imports taskbar pins once and saves them as editable per-widget shortcuts.",
      "additionalProperties": false,
      "properties": {
        "iconSize": {
          "type": "string",
          "enum": ["small", "medium", "large", "huge", "automatic"],
          "default": "huge",
          "description": "Fixed cells: small 72 DIP, medium 96 DIP, large 144 DIP, huge 192 DIP (default). automatic starts at huge and shrinks toward small before paging."
        },
        "shortcuts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "description": "Closed list of 0 through 32 shortcuts.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": { "$ref": "#/$defs/actionName", "description": "Omitted means system.launch. Any other action requires icon." },
              "target": { "$ref": "#/$defs/actionTarget", "description": "Required for system.launch; its grammar depends on the action." },
              "icon": { "$ref": "#/$defs/bindingIcon" }
            }
          }
        }
      }
    },
    "deskClockSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flipDurationMilliseconds": { "type": "integer", "minimum": 250, "maximum": 800, "default": 420 },
        "cardColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FF3B43" },
        "digitColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FFFFFF" },
        "dateColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#D8D8D8" }
      }
    },
    "weight": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 1 },
    "actionName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*){1,3}$",
      "maxLength": 64,
      "description": "<namespace>.<verb>: page.*, widget.*, redxe.*, system.*, keys.*, mouse.* (host), logicon.* and zoom.* (published). See docs/actions.md."
    },
    "actionTarget": { "type": "string", "maxLength": 512 },
    "bindingIcon": {
      "type": "string",
      "maxLength": 260,
      "description": "A Segoe Fluent Icons glyph name such as Home, or png:<absolute path>."
    },
    "logiconKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot"],
      "properties": {
        "page": { "type": "integer", "minimum": 0, "maximum": 3, "default": 0 },
        "slot": { "type": "integer", "minimum": 0, "maximum": 8 },
        "action": { "$ref": "#/$defs/actionName" },
        "target": { "$ref": "#/$defs/actionTarget" },
        "label": { "type": "string", "maxLength": 16 },
        "icon": { "$ref": "#/$defs/bindingIcon" },
        "color": { "$ref": "#/$defs/color" },
        "face": { "enum": ["none", "clock", "pageIndicator", "cpu", "memory", "gpu"], "default": "none" }
      }
    },
    "logiconDialButton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["button"],
      "properties": {
        "button": { "type": "integer", "minimum": 0, "maximum": 3 },
        "action": { "$ref": "#/$defs/actionName" },
        "target": { "$ref": "#/$defs/actionTarget" }
      }
    },
    "logiconTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "direction"],
      "properties": {
        "control": { "enum": ["dial", "roller"] },
        "direction": { "enum": ["cw", "ccw", "up", "down"], "description": "cw/ccw for the dial, up/down for the roller." },
        "action": { "$ref": "#/$defs/actionName" },
        "target": { "$ref": "#/$defs/actionTarget" }
      }
    },
    "logiconDialpad": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turns": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/logiconTurn" } },
        "buttons": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/logiconDialButton" } }
      }
    },
    "zoomLabel": { "type": "string", "minLength": 1, "maxLength": 64 },
    "zoomSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientId": { "type": "string", "maxLength": 128, "description": "The Zoom Marketplace General app's client id (Plugin SDK enabled). Never a secret. Required unless mode is shortcuts." },
        "redirectPort": { "type": "integer", "minimum": 1024, "maximum": 65535, "default": 48123, "description": "Loopback port of the OAuth redirect URL http://127.0.0.1:<port>/redirect registered in the Marketplace app." },
        "domain": { "type": "string", "minLength": 1, "maxLength": 128, "default": "zoom.us" },
        "displayName": { "type": "string", "maxLength": 128, "default": "" },
        "autoConnect": { "type": "boolean", "default": false, "description": "true connects to the Zoom client at start when a credential exists; false connects at the first zoom.* action." },
        "mode": { "type": "string", "enum": ["auto", "sdk", "local"], "default": "auto", "description": "auto: the Plugin SDK when the account allows the app, else the Zoom client's own meeting toolbar through its accessibility interface; sdk: never fall back; local: never use the SDK (no Marketplace app needed)." },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "description": "The meeting toolbar button names the local mode matches to read the state and to press (English Zoom Workplace 7.1.5 defaults; set them for another Zoom language).",
          "properties": {
            "muted": { "$ref": "#/$defs/zoomLabel", "default": "currently muted" },
            "unmuted": { "$ref": "#/$defs/zoomLabel", "default": "currently unmuted" },
            "videoOn": { "$ref": "#/$defs/zoomLabel", "default": "Stop my video" },
            "videoOff": { "$ref": "#/$defs/zoomLabel", "default": "Start my video" },
            "handRaised": { "$ref": "#/$defs/zoomLabel", "default": "Lower hand" },
            "handLowered": { "$ref": "#/$defs/zoomLabel", "default": "Raise hand" },
            "share": { "$ref": "#/$defs/zoomLabel", "default": "Share," },
            "record": { "$ref": "#/$defs/zoomLabel", "default": "Record" },
            "leave": { "$ref": "#/$defs/zoomLabel", "default": "Leave," },
            "end": { "$ref": "#/$defs/zoomLabel", "default": "End," }
          }
        }
      }
    },
    "logiconSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brightness": { "type": "integer", "minimum": 1, "maximum": 100, "default": 70 },
        "restoreLogoOnExit": { "type": "boolean", "default": true },
        "pageButtons": { "enum": ["keyPages", "dashboardPages"], "default": "keyPages" },
        "keys": { "type": "array", "maxItems": 36, "items": { "$ref": "#/$defs/logiconKey" } },
        "dialpad": { "$ref": "#/$defs/logiconDialpad" }
      }
    },
    "dock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edge": {
          "enum": ["none", "top", "bottom", "left", "right"],
          "default": "none",
          "description": "Edge of the selected monitor the bar is attached to. none disables the dock."
        },
        "monitor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "default": "primary",
          "description": "primary, xeneon (the discovered XENEON display), a 1-based display number, or name:<substring> of the display name. A display that is not found falls back to the primary."
        },
        "thickness": {
          "type": "integer",
          "minimum": 32,
          "maximum": 1080,
          "default": 180,
          "description": "Bar thickness across the edge, in DIPs (scaled by the monitor DPI); clamped to half the monitor."
        },
        "mode": {
          "enum": ["fixed", "autohide"],
          "default": "fixed",
          "description": "fixed keeps the whole bar on screen; autohide collapses it to a peek strip until the pointer dwells on it."
        },
        "reserveWorkArea": {
          "type": "boolean",
          "default": true,
          "description": "fixed only: register the bar with the shell so maximized windows stop at it. Ignored in autohide."
        },
        "peek": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 4,
          "description": "autohide only: physical pixels of the bar that stay visible while hidden."
        },
        "revealDelayMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "default": 150,
          "description": "autohide only: pointer dwell on the peek strip before the bar reveals. 0 reveals on the first mouse move."
        },
        "hideDelayMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "default": 800,
          "description": "autohide only: delay after the pointer has left and the bar is inactive before it collapses."
        }
      }
    },
    "serviceDefinition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.logicon" },
            "brightness": { "$ref": "#/$defs/logiconSettings/properties/brightness" },
            "restoreLogoOnExit": { "$ref": "#/$defs/logiconSettings/properties/restoreLogoOnExit" },
            "pageButtons": { "$ref": "#/$defs/logiconSettings/properties/pageButtons" },
            "keys": { "$ref": "#/$defs/logiconSettings/properties/keys" },
            "dialpad": { "$ref": "#/$defs/logiconSettings/properties/dialpad" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.zoom" },
            "clientId": { "$ref": "#/$defs/zoomSettings/properties/clientId" },
            "redirectPort": { "$ref": "#/$defs/zoomSettings/properties/redirectPort" },
            "domain": { "$ref": "#/$defs/zoomSettings/properties/domain" },
            "displayName": { "$ref": "#/$defs/zoomSettings/properties/displayName" },
            "autoConnect": { "$ref": "#/$defs/zoomSettings/properties/autoConnect" },
            "mode": { "$ref": "#/$defs/zoomSettings/properties/mode" },
            "labels": { "$ref": "#/$defs/zoomSettings/properties/labels" }
          }
        }
      ]
    },
    "pluginId": {
      "enum": [
        "builtin.rotating-triangle",
        "builtin.gdi-orbit",
        "builtin.matrix-rain",
        "builtin.5h4d3r5",
        "builtin.studio-clock",
        "builtin.desk-clock",
        "builtin.weather",
        "builtin.launcher",
        "builtin.av-control",
        "builtin.process-viewer",
        "builtin.system-pulse",
        "builtin.cpu-meter",
        "builtin.memory-meter",
        "builtin.network-meter",
        "builtin.storage-meter",
        "builtin.gpu-meter",
        "builtin.gpu-processes",
        "builtin.power-meter",
        "builtin.thermal-meter",
        "builtin.logicon-monitor"
      ]
    },
    "widgetDefinition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "enum": ["builtin.rotating-triangle", "builtin.gdi-orbit", "builtin.system-pulse", "builtin.cpu-meter", "builtin.memory-meter", "builtin.storage-meter", "builtin.gpu-meter", "builtin.power-meter", "builtin.thermal-meter", "builtin.logicon-monitor"] },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.matrix-rain" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "seed": { "$ref": "#/$defs/matrixSettings/properties/seed" },
            "glyphHeightDips": { "$ref": "#/$defs/matrixSettings/properties/glyphHeightDips" },
            "densityPercent": { "$ref": "#/$defs/matrixSettings/properties/densityPercent" },
            "speedPercent": { "$ref": "#/$defs/matrixSettings/properties/speedPercent" },
            "trailLengthGlyphs": { "$ref": "#/$defs/matrixSettings/properties/trailLengthGlyphs" },
            "mutationPerSecond": { "$ref": "#/$defs/matrixSettings/properties/mutationPerSecond" },
            "headColor": { "$ref": "#/$defs/matrixSettings/properties/headColor" },
            "trailColor": { "$ref": "#/$defs/matrixSettings/properties/trailColor" },
            "glowPercent": { "$ref": "#/$defs/matrixSettings/properties/glowPercent" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.5h4d3r5" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "mode": { "$ref": "#/$defs/shadersSettings/properties/mode" },
            "shader": { "$ref": "#/$defs/shadersSettings/properties/shader" },
            "intervalSeconds": { "$ref": "#/$defs/shadersSettings/properties/intervalSeconds" },
            "shuffle": { "$ref": "#/$defs/shadersSettings/properties/shuffle" },
            "renderScalePercent": { "$ref": "#/$defs/shadersSettings/properties/renderScalePercent" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.process-viewer" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "topN": { "$ref": "#/$defs/processViewerSettings/properties/topN" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "enum": ["builtin.network-meter", "builtin.gpu-processes"] },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "topN": { "$ref": "#/$defs/rankedViewerSettings/properties/topN" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.studio-clock" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "showSecondProgress": { "$ref": "#/$defs/studioClockSettings/properties/showSecondProgress" },
            "externalDotsAlwaysOn": { "$ref": "#/$defs/studioClockSettings/properties/externalDotsAlwaysOn" },
            "showSeconds": { "$ref": "#/$defs/studioClockSettings/properties/showSeconds" },
            "secondsColor": { "$ref": "#/$defs/studioClockSettings/properties/secondsColor" },
            "showDate": { "$ref": "#/$defs/studioClockSettings/properties/showDate" },
            "dateFormat": { "$ref": "#/$defs/studioClockSettings/properties/dateFormat" },
            "timeColor": { "$ref": "#/$defs/studioClockSettings/properties/timeColor" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.desk-clock" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "flipDurationMilliseconds": { "$ref": "#/$defs/deskClockSettings/properties/flipDurationMilliseconds" },
            "cardColor": { "$ref": "#/$defs/deskClockSettings/properties/cardColor" },
            "digitColor": { "$ref": "#/$defs/deskClockSettings/properties/digitColor" },
            "dateColor": { "$ref": "#/$defs/deskClockSettings/properties/dateColor" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.weather" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "locationMode": { "$ref": "#/$defs/weatherSettings/properties/locationMode" },
            "location": { "$ref": "#/$defs/weatherSettings/properties/location" },
            "temperatureUnit": { "$ref": "#/$defs/weatherSettings/properties/temperatureUnit" },
            "windUnit": { "$ref": "#/$defs/weatherSettings/properties/windUnit" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.launcher" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "iconSize": { "$ref": "#/$defs/launcherSettings/properties/iconSize" },
            "shortcuts": { "$ref": "#/$defs/launcherSettings/properties/shortcuts" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin"],
          "properties": {
            "plugin": { "const": "builtin.av-control" },
            "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
            "profiles": { "$ref": "#/$defs/avControlSettings/properties/profiles" }
          }
        }
      ]
    },
    "widgetUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use"],
      "properties": {
        "use": { "type": "string", "minLength": 1, "maxLength": 128 },
        "plugin": { "$ref": "#/$defs/pluginId" },
        "seed": { "$ref": "#/$defs/matrixSettings/properties/seed" },
        "glyphHeightDips": { "$ref": "#/$defs/matrixSettings/properties/glyphHeightDips" },
        "densityPercent": { "$ref": "#/$defs/matrixSettings/properties/densityPercent" },
        "speedPercent": { "$ref": "#/$defs/matrixSettings/properties/speedPercent" },
        "trailLengthGlyphs": { "$ref": "#/$defs/matrixSettings/properties/trailLengthGlyphs" },
        "mutationPerSecond": { "$ref": "#/$defs/matrixSettings/properties/mutationPerSecond" },
        "headColor": { "$ref": "#/$defs/matrixSettings/properties/headColor" },
        "trailColor": { "$ref": "#/$defs/matrixSettings/properties/trailColor" },
        "backgroundColor": { "$ref": "#/$defs/widgetBackground" },
        "glowPercent": { "$ref": "#/$defs/matrixSettings/properties/glowPercent" },
        "mode": { "$ref": "#/$defs/shadersSettings/properties/mode" },
        "shader": { "$ref": "#/$defs/shadersSettings/properties/shader" },
        "intervalSeconds": { "$ref": "#/$defs/shadersSettings/properties/intervalSeconds" },
        "shuffle": { "$ref": "#/$defs/shadersSettings/properties/shuffle" },
        "renderScalePercent": { "$ref": "#/$defs/shadersSettings/properties/renderScalePercent" },
        "topN": { "type": "integer", "minimum": 1, "maximum": 32 },
        "showSecondProgress": { "type": "boolean" },
        "externalDotsAlwaysOn": { "type": "boolean" },
        "showSeconds": { "type": "boolean" },
        "secondsColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "showDate": { "type": "boolean" },
        "dateFormat": { "enum": ["dd-mm-yyyy", "mm-dd-yyyy", "yyyy-mm-dd"] },
        "timeColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "flipDurationMilliseconds": { "type": "integer", "minimum": 250, "maximum": 800 },
        "cardColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "digitColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "dateColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "locationMode": { "type": "string", "enum": ["automatic", "manual"] },
        "location": { "type": "string" },
        "temperatureUnit": { "type": "string", "enum": ["celsius", "fahrenheit"] },
        "windUnit": { "type": "string", "enum": ["kmh", "mph"] },
        "iconSize": { "$ref": "#/$defs/launcherSettings/properties/iconSize" },
        "shortcuts": { "$ref": "#/$defs/launcherSettings/properties/shortcuts" },
        "profiles": { "$ref": "#/$defs/avControlSettings/properties/profiles" }
      }
    },
    "widgetValue": {
      "oneOf": [
        { "$ref": "#/$defs/widgetDefinition" },
        { "type": "string", "minLength": 1, "maxLength": 128 },
        { "$ref": "#/$defs/widgetUse" }
      ]
    },
    "splitItem": {
      "oneOf": [
        { "$ref": "#/$defs/widgetValue" },
        { "$ref": "#/$defs/weightedWidget" },
        { "$ref": "#/$defs/weightedRows" },
        { "$ref": "#/$defs/weightedColumns" }
      ]
    },
    "weightedWidget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widget"],
      "properties": {
        "weight": { "$ref": "#/$defs/weight" },
        "widget": { "$ref": "#/$defs/widgetValue" }
      }
    },
    "weightedRows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "weight": { "$ref": "#/$defs/weight" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 127,
          "items": { "$ref": "#/$defs/splitItem" }
        }
      }
    },
    "weightedColumns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "weight": { "$ref": "#/$defs/weight" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 127,
          "items": { "$ref": "#/$defs/splitItem" }
        }
      }
    },
    "page": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["widgets"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "along": { "enum": ["long-side", "short-side"], "default": "long-side" },
            "widgets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/widgetValue" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 127,
              "items": { "$ref": "#/$defs/splitItem" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 127,
              "items": { "$ref": "#/$defs/splitItem" }
            }
          }
        }
      ]
    }
  }
}
